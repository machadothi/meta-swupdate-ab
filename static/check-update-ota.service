[Unit]
Description=OTA Update Rollback Guard — commits successful boots after an update
Documentation=https://github.com/your-org/meta-swupdate-ab
# Run after the network is up and basic services are started
After=multi-user.target
# Only run once — if it fails, do not retry (a failed commit means rollback kicks in)
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/checkUpdateOTA.sh
# Keep the unit in "active" state after the script exits (for status checking)
RemainAfterExit=true
# Do not restart on failure — let U-Boot handle the rollback
Restart=no

[Install]
WantedBy=multi-user.target
